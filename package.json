{
	"name": "@e280/scute",
	"version": "0.5.7",
	"description": "buildy bundly static site generator",
	"license": "MIT",
	"author": "Chase Moskal <chasemoskal@gmail.com>",
	"type": "module",
	"main": "./x/index.js",
	"exports": {
		".": "./x/index.js"
	},
	"files": [
		"x",
		"s"
	],
	"bin": {
		"scute": "./x/scute/cli.js"
	},
	"scripts": {
		"build": "rm -rf x && mkdir x && tsc && chmod +x x/scute/cli.js",
		"scute": "node ./x/scute/cli.js -v",
		"help": "node ./x/scute/cli.js --help",
		"dev": "node --watch x/test.js & tsc -w & http-server x & wait",
		"test": "node x/test.js"
	},
	"allowScripts": {
		"esbuild@0.28.2": true
	},
	"dependencies": {
		"@benev/argv": "^0.3.14",
		"@e280/sten": "^0.1.1",
		"@e280/stz": "^0.4.18",
		"braces": "^3.0.3",
		"chokidar": "^6.0.0",
		"esbuild": "^0.28.2",
		"globby": "^16.2.4",
		"minimatch": "^11.0.9",
		"shell-quote": "^1.12.0",
		"zx": "^8.8.5"
	},
	"devDependencies": {
		"@e280/science": "^0.1.14",
		"@types/braces": "^3.0.5",
		"@types/node": "^26.6.6",
		"@types/shell-quote": "^1.7.5",
		"http-server": "^14.1.1",
		"typescript": "^7.0.2"
	},
	"keywords": [
		"static site generator",
		"ssg"
	],
	"homepage": "https://github.com/e280/scute#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/e280/scute.git"
	},
	"bugs": {
		"url": "https://github.com/e280/scute/issues"
	}
}
